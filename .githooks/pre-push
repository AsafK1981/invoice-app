#!/usr/bin/env bash
# Pre-push hook — blocks pushes that would regress security or ship stale URLs.
# Skip with: git push --no-verify
set -e

cd "$(git rev-parse --show-toplevel)"

echo "[pre-push] 1/8 typecheck..."
if ! npx tsc --noEmit > /tmp/prepush-tsc.log 2>&1; then
  echo "✗ typecheck failed:"
  cat /tmp/prepush-tsc.log
  echo ""
  echo "To bypass (don't): git push --no-verify"
  exit 1
fi
echo "✓ types clean"

echo "[pre-push] 2/8 react-hooks lint..."
if ! npx eslint src/ > /tmp/prepush-eslint.log 2>&1; then
  echo "✗ react-hooks lint failed (this catches React error #310 — hooks after early returns):"
  cat /tmp/prepush-eslint.log
  exit 1
fi
echo "✓ hooks ordered"

echo "[pre-push] 3/8 unit tests..."
if ! npx vitest run > /tmp/prepush-tests.log 2>&1; then
  echo "✗ tests failed:"
  cat /tmp/prepush-tests.log
  exit 1
fi
echo "✓ tests pass"

echo "[pre-push] 4/8 anon-read security check..."
if ! node scripts/check-anon-read.mjs; then
  exit 1
fi

echo "[pre-push] 5/8 raw origin literal grep..."
# Every user-facing origin must come from CANONICAL_ORIGIN (src/lib/public-url.ts)
# so that buying a domain is a one-value change instead of a 30-file sweep.
# This bans raw origins in shipped code rather than pinning one specific domain
# (which is what this check used to do, and which would have blocked the very
# migration it was meant to protect).
#
# Escape hatch: append `domain-literal-ok` on the same line, with a comment
# saying why. The legitimate survivors are the fallback inside public-url.ts
# and the two רשות המסים redirect_uri values, which must byte-match what is
# registered with שע"מ and therefore must NOT follow the canonical origin.

# The host is READ FROM public-url.ts rather than hardcoded here, so this check
# keeps working after a domain migration instead of pinning the old domain
# forever. Third-party URLs (competitors, Google, Meshulam) are untouched — only
# our OWN origin is banned, because only our own origin needs to move.
SELF_HOST=$(grep -oE '"https://[a-z0-9.-]+"' src/lib/public-url.ts | head -1 | tr -d '"' | sed 's|https://||')
if [ -z "$SELF_HOST" ]; then
  echo "✗ could not read the canonical host from src/lib/public-url.ts"
  echo "  (this guard derives it from the fallback literal there)"
  exit 1
fi

if grep -rEn "${SELF_HOST}|http://localhost:3000" \
     src/ --include="*.ts" --include="*.tsx" --include="*.md" 2>/dev/null \
   | grep -v "domain-literal-ok" \
   | grep -v "^src/lib/public-url.ts:"; then
  echo "✗ raw self-origin literal in src/ (above)"
  echo "  '${SELF_HOST}' must not be hardcoded — import CANONICAL_ORIGIN,"
  echo "  CANONICAL_HOST or absoluteUrl from @/lib/public-url instead, so that"
  echo "  changing domains stays a one-value change."
  echo "  If the literal is genuinely required (e.g. a redirect_uri registered"
  echo "  with a third party), append 'domain-literal-ok' on that line with a"
  echo "  comment explaining why."
  exit 1
fi
echo "✓ no raw self-origin literals (host: ${SELF_HOST})"

echo "[pre-push] 6/8 plan/polar fields in user_metadata (write side)..."
# user_metadata is user-writable from the browser console. Writing
# plan_* / polar_* / stripe_* fields to user_metadata = user can grant
# themselves Pro for free. They must go into app_metadata (admin-only).
# Catches `user_metadata: { ... plan_tier ... }` shapes in route handlers.
if grep -rEn "user_metadata:[^}]*(plan_|polar_subscription_id|polar_customer_id|stripe_subscription_id|stripe_customer_id)" src/app/api/ 2>/dev/null; then
  echo "✗ A route handler writes plan/polar fields to user_metadata (above)."
  echo "  user_metadata is user-writable from the browser console — a hacker"
  echo "  could grant themselves Pro by editing it. Use app_metadata instead:"
  echo "    admin.auth.admin.updateUserById(id, { app_metadata: { plan_tier: ... } })"
  exit 1
fi
echo "✓ plan fields go to app_metadata only"

echo "[pre-push] 7/8 SECURITY DEFINER rpc exposure..."
# Catches the CSO-2026-08-11 bug class: a SECURITY DEFINER function whose
# default PUBLIC execute grant makes it anon/authenticated-callable via
# PostgREST, bypassing the API routes. Skips gracefully without DB creds.
if ! node scripts/check-secdef-grants.mjs; then
  exit 1
fi

echo "[pre-push] 8/8 secret scan (gitleaks)..."
GITLEAKS_BIN="$(command -v gitleaks || true)"
if [ -z "$GITLEAKS_BIN" ]; then
  # winget portable install (PATH may not be refreshed in this shell yet).
  _WG="$LOCALAPPDATA/Microsoft/WinGet/Packages/Gitleaks.Gitleaks_Microsoft.Winget.Source_8wekyb3d8bbwe/gitleaks.exe"
  [ -x "$_WG" ] && GITLEAKS_BIN="$_WG"
fi
if [ -z "$GITLEAKS_BIN" ]; then
  echo "⚠ gitleaks not installed — skipping secret scan."
  echo "  Install: winget install --id Gitleaks.Gitleaks -e"
else
  if ! "$GITLEAKS_BIN" detect --no-banner --redact -c .gitleaks.toml > /tmp/prepush-gitleaks.log 2>&1; then
    echo "✗ gitleaks found a potential secret:"
    cat /tmp/prepush-gitleaks.log
    echo ""
    echo "If it's a false positive, add an allowlist entry in .gitleaks.toml."
    echo "To bypass (don't): git push --no-verify"
    exit 1
  fi
  echo "✓ no secrets detected"
fi

echo "[pre-push] all checks passed"
