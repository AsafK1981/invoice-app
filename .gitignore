# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# smoke-test output
/tmp/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# security reports (contain exploit details — never commit)
AEGIS_*.pdf
*Security_Report*.pdf
*security_report*.pdf

# Tax Authority forms — only commit blank public-domain templates,
# never signed/scanned versions (they contain Asaf's ID, signature,
# and personal details). The 2 blank PDFs already committed are fine;
# signed scans dropped here will be auto-excluded.
Rashot Hamisim/**/*signed*
Rashot Hamisim/**/*חתום*
Rashot Hamisim/**/*scan*
Rashot Hamisim/**/*סרוק*
Rashot Hamisim/**/*filled*
Rashot Hamisim/**/*מולא*
.gstack/
